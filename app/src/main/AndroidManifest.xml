<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>

    <!-- Android 11+ package visibility: lets us see TTS engines and their data/install screens -->
    <queries>
        <intent><action android:name="android.intent.action.TTS_SERVICE"/></intent>
        <intent><action android:name="android.speech.tts.engine.CHECK_TTS_DATA"/></intent>
        <intent><action android:name="android.speech.tts.engine.INSTALL_TTS_DATA"/></intent>
    </queries>

    <application
        android:name=".App"
        android:label="BG Browser"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".IncognitoActivity"
            android:label="BG Incognito"
            android:exported="false"
            android:process=":incognito"
            android:taskAffinity="com.bgbrowser.incognito"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".TorActivity"
            android:label="BG Tor"
            android:exported="false"
            android:process=":tor"
            android:taskAffinity="com.bgbrowser.tor"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize"/>

        <activity android:name=".SettingsActivity" android:exported="false" android:label="Settings"/>
        <activity android:name=".WelcomeActivity" android:exported="false" android:label="Welcome"/>

        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"/>
        <service
            android:name=".IncognitoKeepService"
            android:exported="false"
            android:process=":incognito"
            android:foregroundServiceType="mediaPlayback"/>
        <service
            android:name=".TorKeepService"
            android:exported="false"
            android:process=":tor"
            android:foregroundServiceType="mediaPlayback"/>

        <!-- Guardian Project Tor service runs in the same process as TorActivity -->
        <service android:name="org.torproject.jni.TorService" android:process=":tor" tools:node="merge"/>

        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
